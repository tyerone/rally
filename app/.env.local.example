# Copy this file to .env.local (gitignored) and fill in your Supabase project's
# values from Settings -> API. Both of these are safe to expose to the client
# by design (row-level security is what actually protects the data) — but
# .env.local should still stay untracked, just to keep project-specific values
# out of git history.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed locally when running scripts/import-roster.mjs — NEVER put the
# service_role key in a VITE_-prefixed variable, since anything with that
# prefix gets bundled into the client-side app.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
